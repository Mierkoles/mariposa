    { "id": "piel", "es": "piel", "en": "hide", "pos": "noun", "note": "la piel. Skin, or an animal's hide. Piel de ciervo, deerskin." },
    { "id": "ciervo", "es": "ciervo", "en": "deer", "pos": "noun", "note": "el ciervo. In the Americas you will also hear venado." },
    { "id": "cacique", "es": "cacique", "en": "chief", "pos": "noun", "cognate": true, "note": "el cacique. Spanish took it from the Taíno of the Caribbean and used it everywhere after." },
